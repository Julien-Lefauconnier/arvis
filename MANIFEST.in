include LICENSE
include NOTICE
include README.md
include CHANGELOG.md
include SECURITY.md
include CONTRIBUTING.md
include VERSIONING.md
include arvis/py.typed
recursive-include arvis/api/schema *.json
# A redistributor must be able to replay the suite and the black-box
# compliance checks from the sdist alone (campaign HARDEN, LOT S,
# audit P1-12/P2 packaging: the previous sdist shipped none of it).
include pytest.ini
include requirements/gate.lock
recursive-include tests *.py *.json *.yaml *.yml *.md
recursive-include compliance *.py *.yaml *.yml *.json *.md
recursive-include validation *.py *.json *.md
recursive-include scripts *.py *.sh
recursive-include docs *.md
recursive-include examples *.py *.md
global-exclude *.py[cod]
global-exclude __pycache__
